{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ore Rulebook",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "category": {
      "type": "string",
      "enum": ["metal", "energy_element", "construction_material", "chemical", "gas"]
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "medium", "rare", "very_rare"]
    },
    "is_raw": {
      "type": "boolean"
    },
    "usage_areas": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["category", "rarity", "is_raw", "usage_areas", "risks"]
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Maden Kural Kitabi",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kategori": {
      "type": "string",
      "enum": ["metal", "enerji_elementi", "yapi_maddesi", "kimyasal", "gaz"]
    },
    "nadirlik": {
      "type": "string",
      "enum": ["yaygin", "orta", "nadir", "cok_nadir"]
    },
    "ham_mi": {
      "type": "boolean"
    },
    "kullanim_alanlari": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "risk": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["kategori", "nadirlik", "ham_mi", "kullanim_alanlari", "risk"]
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Production Recipe Rulebook",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "required_materials": {
      "type": "object",
      "patternProperties": {
        "^[a-z_]+$": { "type": "integer", "minimum": 1 }
      }
    },
    "required_station": {
      "type": "string"
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "energy_consumption": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["required_materials", "required_station", "time", "energy_consumption"]
}